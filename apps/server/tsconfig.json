{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@personalass/contracts": ["../../packages/contracts/src/index.ts"],
      "@personalass/contracts/errors": ["../../packages/contracts/src/errors.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
