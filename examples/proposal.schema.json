{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalAss Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_revision_id",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "quote"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "operation",
        "entity_type",
        "target_id",
        "expected_version",
        "fields",
        "evidence",
        "ambiguity",
        "depends_on"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "create",
            "update",
            "request_confirmation"
          ]
        },
        "entity_type": {
          "enum": [
            "task",
            "appointment",
            "note",
            "person",
            "asset",
            "interaction",
            "maintenance_record"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "fields": {
          "type": "object"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "ambiguity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field_path",
              "reason",
              "question"
            ],
            "properties": {
              "field_path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "question": {
                "type": "string"
              }
            }
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
