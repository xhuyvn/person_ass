APP_MODE=local
HOST=127.0.0.1
PORT=2310
DATA_DIR=./.data
APP_ORIGIN=http://127.0.0.1:2311,http://localhost:2311
# Client-side only: inlined into the web/native bundle by Metro. Never put a secret here.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:2310
# Extra Host header values allowed (comma separated, exact, may include a port). Added to the default loopback allowlist; never "*".
ALLOWED_HOSTS=
TZ=Asia/Ho_Chi_Minh
MASTER_KEY_FILE=./.data/secrets/master.key
TRUST_PROXY=false
LOG_LEVEL=info
WORKER_CONCURRENCY=1
SCHEDULER_TICK_SECONDS=15
# Per-image byte limit.
MAX_UPLOAD_BYTES=10485760
# Images per memo (1-10).
MAX_IMAGES_PER_MEMO=10
# Decoded pixel limit per image (decompression bomb guard).
MAX_IMAGE_PIXELS=40000000
# How long an uploaded image waits for its memo before it is deleted.
ATTACHMENT_TOKEN_TTL_MINUTES=1440
# Longest edge of the EXIF-free copy used for AI/OCR.
DERIVED_IMAGE_MAX_EDGE=2048
ENABLE_DEBUG_AI=false
